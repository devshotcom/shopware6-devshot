<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <service id="Devshot\Connector\Service\ProjectFileArchive">
            <argument>%kernel.project_dir%</argument>
        </service>

        <service id="Devshot\Connector\Service\WorkspaceSyncService">
            <argument type="service" id="Devshot\Connector\Service\AnonymizedDatabaseBackup"/>
            <argument type="service" id="Devshot\Connector\Service\ProjectFileArchive"/>
            <argument type="service" id="Devshot\Connector\Service\AiWorkspaceClient"/>
            <argument type="service" id="Devshot\Connector\Service\TemporaryWorkspace"/>
        </service>

        <service id="Devshot\Connector\Command\SyncWorkspaceCommand">
            <argument type="service" id="Devshot\Connector\Service\WorkspaceSyncService"/>
            <tag name="console.command"/>
        </service>

        <service id="Devshot\Connector\Service\AnonymizedDatabaseBackup"/>
        <service id="Devshot\Connector\Service\AiWorkspaceClient"/>
        <service id="Devshot\Connector\Service\TemporaryWorkspace"/>

        <service id="Devshot\Connector\Service\PairingService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Devshot\Connector\Controller\PairingPublicController" public="true">
            <argument type="service" id="Devshot\Connector\Service\PairingService"/>
            <argument type="service" id="Devshot\Connector\Service\WorkspaceSyncService"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="Devshot\Connector\Controller\PairingAdminController" public="true">
            <argument type="service" id="Devshot\Connector\Service\PairingService"/>
            <tag name="controller.service_arguments"/>
        </service>
    </services>
</container>
